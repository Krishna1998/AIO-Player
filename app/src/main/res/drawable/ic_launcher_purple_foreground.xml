<?xml version="1.0" encoding="utf-8"?>
<!-- V&M Player Flagship Icon: Harmonic Duet (Playhead & Musical Note) at 95% Geometric Scale -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- 95% Geometric Size Scaling -->
    <group
        android:name="launcher_bounds"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.95"
        android:scaleY="0.95">

        <!-- Video Playhead (Left) -->
        <path
            android:pathData="M 182,170 L 296,244 C 310,253 310,259 296,268 L 182,342 C 168,351 156,344 156,328 L 156,184 C 156,168 168,161 182,170 Z"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="92"
                    android:startY="102"
                    android:endX="450"
                    android:endY="420"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF8B5CF6"/>
                    <item android:offset="0.3" android:color="#FFA855F7"/>
                    <item android:offset="0.55" android:color="#FFEC4899"/>
                    <item android:offset="0.78" android:color="#FFF43F5E"/>
                    <item android:offset="1.0" android:color="#FFFB923C"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Music Note Head (Hollow Ring) -->
        <path
            android:pathData="M 320,288 A 28,28 0 1,0 320.1,288 Z"
            android:strokeWidth="26">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="92"
                    android:startY="102"
                    android:endX="450"
                    android:endY="420"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF8B5CF6"/>
                    <item android:offset="0.3" android:color="#FFA855F7"/>
                    <item android:offset="0.55" android:color="#FFEC4899"/>
                    <item android:offset="0.78" android:color="#FFF43F5E"/>
                    <item android:offset="1.0" android:color="#FFFB923C"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Music Note Stem & Curved Hook -->
        <path
            android:pathData="M 348,316 L 348,180 C 348,166 358,164 368,172 C 382,184 394,204 388,244"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="92"
                    android:startY="102"
                    android:endX="450"
                    android:endY="420"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF8B5CF6"/>
                    <item android:offset="0.3" android:color="#FFA855F7"/>
                    <item android:offset="0.55" android:color="#FFEC4899"/>
                    <item android:offset="0.78" android:color="#FFF43F5E"/>
                    <item android:offset="1.0" android:color="#FFFB923C"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
