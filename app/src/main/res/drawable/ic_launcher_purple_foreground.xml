            android:name="logo_tip"
            android:pivotX="295"
            android:pivotY="256">

            <!-- Cyan Neon Glow Aura: Wide -->
            <path
                android:pathData="M 265,231 C 265,221 276,215 284,220 L 322,245 C 330,250 330,262 322,267 L 284,292 C 276,297 265,291 265,281 Z"
                android:strokeWidth="28"
                android:strokeColor="#3000f5ff"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />

            <!-- Cyan Neon Glow Aura: Medium -->
            <path
                android:pathData="M 265,231 C 265,221 276,215 284,220 L 322,245 C 330,250 330,262 322,267 L 284,292 C 276,297 265,291 265,281 Z"
                android:strokeWidth="16"
                android:strokeColor="#6500f5ff"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />

            <!-- Center Core Gradient Fill -->
            <path
                android:pathData="M 265,231 C 265,221 276,215 284,220 L 322,245 C 330,250 330,262 322,267 L 284,292 C 276,297 265,291 265,281 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="265"
                        android:startY="220"
                        android:endX="325"
                        android:endY="290">
                        <item android:offset="0.0" android:color="#ff38bdf8" />
                        <item android:offset="0.45" android:color="#ff00f5ff" />
                        <item android:offset="1.0" android:color="#ff2563eb" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Crisp Specular Rim -->
            <path
                android:pathData="M 265,231 C 265,221 276,215 284,220 L 322,245 C 330,250 330,262 322,267 L 284,292 C 276,297 265,291 265,281 Z"
                android:strokeWidth="3"
                android:strokeColor="#f0f9ff"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />
