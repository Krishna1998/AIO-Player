                android:strokeWidth="10"
                android:strokeColor="#38ff2a6d"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M 356,206 C 362.07,206 367,210.93 367,217 L 367,295 C 367,301.07 362.07,306 356,306 C 349.93,306 345,301.07 345,295 L 345,217 C 345,210.93 349.93,206 356,206 Z"
                android:fillColor="#c8ff2a6d" />

            <!-- Bar 4 -->
            <path
                android:pathData="M 392,236 C 398.07,236 403,240.93 403,247 L 403,265 C 403,271.07 398.07,276 392,276 C 385.93,276 381,271.07 381,265 L 381,247 C 381,240.93 385.93,236 392,236 Z"
                android:strokeWidth="8"
                android:strokeColor="#30ff2a6d"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M 392,236 C 398.07,236 403,240.93 403,247 L 403,265 C 403,271.07 398.07,276 392,276 C 385.93,276 381,271.07 381,265 L 381,247 C 381,240.93 385.93,236 392,236 Z"
