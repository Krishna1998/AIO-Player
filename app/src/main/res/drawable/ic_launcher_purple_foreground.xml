<?xml version="1.0" encoding="utf-8"?>
<!-- V&M Player Flagship Icon: Play Triangle & Musical Eighth Note (Faithful to Reference Image) on Pure Black Canvas -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Centered & Scaled to 95% -->
    <group
        android:name="launcher_bounds"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateX="-8"
        android:translateY="0">

        <!-- Video Playhead Triangle (Rounded Outline) -->
        <path
            android:pathData="M 184,168 L 298,244 C 314,254 314,258 298,268 L 184,344 C 168,354 156,346 156,328 L 156,184 C 156,166 168,158 184,168 Z"
            android:strokeWidth="26"
            android:strokeLineJoin="round"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="156"
                    android:startY="158"
                    android:endX="314"
                    android:endY="344"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FF8B5CF6"/>
                    <item android:offset="0.35" android:color="#FFA855F7"/>
                    <item android:offset="0.70" android:color="#FFEC4899"/>
                    <item android:offset="1.0" android:color="#FFF43F5E"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Musical Eighth Note: Circular Notehead -->
        <path
            android:pathData="M 320,324 A 28,28 0 1,0 320.1,324"
            android:strokeWidth="26"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="292"
                    android:startY="352"
                    android:endX="392"
                    android:endY="156"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFEC4899"/>
                    <item android:offset="0.30" android:color="#FFF43F5E"/>
                    <item android:offset="0.70" android:color="#FFFB7185"/>
                    <item android:offset="1.0" android:color="#FFFB923C"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Musical Eighth Note: Vertical Stem & Elegant Flag -->
        <path
            android:pathData="M 348,324 L 348,176 C 348,160 358,156 370,166 C 386,180 400,202 392,246"
            android:strokeWidth="26"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="348"
                    android:startY="324"
                    android:endX="392"
                    android:endY="160"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFF43F5E"/>
                    <item android:offset="0.50" android:color="#FFFB7185"/>
                    <item android:offset="1.0" android:color="#FFFB923C"/>
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
