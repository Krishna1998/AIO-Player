<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Crimson Sonic (Audio + Video) with High-Contrast Center-Core Electric Cyan Playhead -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Scaled safely inside Android adaptive launcher circular safe-zone -->
    <group
        android:name="launcher_bounds"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- Outer Crimson Play Frame & Audio Equalizer Bars -->
        <group
            android:name="logo_main"
            android:pivotX="256"
            android:pivotY="256">

            <!-- Outer Play Frame: Wide Ambient Neon Bloom -->
            <path
                android:pathData="M 148,116 C 148,94 172,80 192,91 L 416,226 C 435,238 435,266 416,278 L 192,413 C 172,424 148,410 148,388 Z"
                android:strokeWidth="38"
                android:strokeColor="#25ff2a6d"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />

            <!-- Outer Play Frame: Medium Glow -->
            <path
                android:pathData="M 148,116 C 148,94 172,80 192,91 L 416,226 C 435,238 435,266 416,278 L 192,413 C 172,424 148,410 148,388 Z"
                android:strokeWidth="24"
                android:strokeColor="#55ff2a6d"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />

            <!-- Outer Play Frame: Core Radiant Neon Stroke -->
            <path
                android:pathData="M 148,116 C 148,94 172,80 192,91 L 416,226 C 435,238 435,266 416,278 L 192,413 C 172,424 148,410 148,388 Z"
                android:strokeWidth="16"
                android:strokeLineJoin="round"
                android:strokeLineCap="round">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:type="linear"
                        android:startX="120"
                        android:startY="90"
                        android:endX="400"
                        android:endY="400">
                        <item android:offset="0.0" android:color="#ffff2a6d" />
                        <item android:offset="0.4" android:color="#ffe11d48" />
                        <item android:offset="1.0" android:color="#ff9f1239" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Outer Play Frame: Specular Highlight Rim -->
            <path
                android:pathData="M 148,116 C 148,94 172,80 192,91 L 416,226 C 435,238 435,266 416,278 L 192,413 C 172,424 148,410 148,388 Z"
                android:strokeWidth="2.5"
                android:strokeColor="#50ffe4e6"
                android:strokeLineJoin="round"
                android:strokeLineCap="round" />

            <!-- Audio Frequency Bars (Music Equalizer) -->
            <!-- Bar 1 -->
            <path
                android:pathData="M 203,221 C 209.07,221 214,225.93 214,232 L 214,280 C 214,286.07 209.07,291 203,291 C 196.93,291 192,286.07 192,280 L 192,232 C 192,225.93 196.93,221 203,221 Z"
                android:strokeWidth="8"
                android:strokeColor="#30ff2a6d"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M 203,221 C 209.07,221 214,225.93 214,232 L 214,280 C 214,286.07 209.07,291 203,291 C 196.93,291 192,286.07 192,280 L 192,232 C 192,225.93 196.93,221 203,221 Z"
                android:fillColor="#a6ff2a6d" />

            <!-- Bar 2 -->
            <path
                android:pathData="M 239,181 C 245.07,181 250,185.93 250,192 L 250,320 C 250,326.07 245.07,331 239,331 C 232.93,331 228,326.07 228,320 L 228,192 C 228,185.93 232.93,181 239,181 Z"
                android:strokeWidth="10"
                android:strokeColor="#38ff2a6d"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M 239,181 C 245.07,181 250,185.93 250,192 L 250,320 C 250,326.07 245.07,331 239,331 C 232.93,331 228,326.07 228,320 L 228,192 C 228,185.93 232.93,181 239,181 Z"
                android:fillColor="#c8ff2a6d" />

            <!-- Bar 3 -->
            <path
