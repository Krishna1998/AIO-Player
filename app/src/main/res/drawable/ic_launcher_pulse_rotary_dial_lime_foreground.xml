<?xml version="1.0" encoding="utf-8"?>
<!-- V&M Player Icon: The Pulse Rotary Dial (Acid Lime) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:name="pulse_rotary_dial"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.80"
        android:scaleY="0.80">

        <!-- 270° Rotary Volume Track -->
        <path
            android:strokeColor="#FFD4FF00"
            android:strokeWidth="24"
            android:strokeLineCap="round"
            android:pathData="M 143,369 A 160,160 0 1,1 369,369" />

        <!-- Inner Rotary Hub -->
        <path
            android:strokeColor="#FFD4FF00"
            android:strokeWidth="14"
            android:pathData="M 160,256 A 96,96 0 1,0 352,256 A 96,96 0 1,0 160,256 Z" />

        <!-- Center Playhead -->
        <path
            android:fillColor="#FFD4FF00"
            android:pathData="M 232,211 L 312,256 L 232,301 Z" />
    </group>
</vector>
