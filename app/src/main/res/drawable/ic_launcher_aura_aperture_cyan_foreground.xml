            android:fillColor="#FF00F0FF"
            android:fillType="evenOdd"
            android:pathData="M 256,144 A 112,112 0 1,0 256,368 A 112,112 0 1,0 256,144 Z M 222,191 L 325,256 L 222,321 Z" />
    </group>
