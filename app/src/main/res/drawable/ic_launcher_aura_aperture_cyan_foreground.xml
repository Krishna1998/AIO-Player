    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:name="aura_aperture_cyan"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.87"
        android:scaleY="0.87">

        <!-- Outer Dim Aura Ring (Electric Cyan at 35% opacity) -->
        <path
            android:strokeColor="#FF00F0FF"
            android:strokeAlpha="0.35"
