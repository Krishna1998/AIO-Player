<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-only rendition: native AVD, 288dp canvas, Continuous Ligature VM inside central 160dp splash mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Inset for Android 12+ circular system splash masks (87% proportional scaling = 0.574) -->
    <group
        android:name="launcher_bounds"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.574"
        android:scaleY="0.574">

        <!-- Unbroken Geometric Monoline Ribbon (Animated Main Logo) -->
        <group
            android:name="logo_main"
            android:pivotX="256"
            android:pivotY="256">
            <path
                android:strokeColor="#FFFF007F"
                android:strokeWidth="28"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 105,172 L 172,365 L 231,214 L 290,365 L 348,214 L 407,365" />
        </group>

        <!-- Centered Playhead (Animated Tip Pop) -->
        <group
            android:name="logo_tip"
            android:pivotX="256"
            android:pivotY="256">
            <path
                android:fillColor="#FFFF007F"
                android:pathData="M 273,147 L 323,180 L 273,214 Z" />
        </group>
    </group>
</vector>
