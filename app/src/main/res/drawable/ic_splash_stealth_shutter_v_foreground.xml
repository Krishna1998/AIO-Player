<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:name="launcher_bounds"
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.574"
        android:scaleY="0.574">

        <group
            android:name="logo_main"
            android:pivotX="256"
            android:pivotY="256">
            <path
                android:strokeWidth="36"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 136,150 L 256,380 L 376,150">
                <aapt:attr name="android:strokeColor">
                    <gradient
                        android:startX="136"
                        android:startY="150"
                        android:endX="376"
                        android:endY="380"
                        android:type="linear">
                        <item android:offset="0.0" android:color="#FF00FF88" />
                        <item android:offset="0.5" android:color="#FF00E5FF" />
                        <item android:offset="1.0" android:color="#FF0077FF" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>

        <group
            android:name="logo_tip"
            android:pivotX="256"
            android:pivotY="256">
            <path
                android:fillColor="#FF00FF88"
                android:pathData="M 236,210 L 296,256 L 236,302 Z" />
            <path
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="4"
                android:strokeLineCap="round"
                android:pathData="M 236,210 L 296,256" />
        </group>
    </group>
</vector>
